VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use whichever key format your project provides:
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# No admin email list here: the admin ("network view") role is read from the
# verafo_admins table via verafo_is_admin(). Keep supabase/rls-production.sql
# up to date instead — nothing in this file can grant admin.

# Local dev ONLY — treat every signed-in user as an admin. Never set in
# production.
# VITE_DEMO_ADMIN=1
