VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use whichever key format your project provides:
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Comma-separated Verafo team emails. These users see EVERY store's data (the
# network view) + the admin-only Stores section. Everyone else is a merchant and
# only ever sees their own store(s). Keep in sync with the verafo_admins table
# (see supabase/rls-production.sql).
VITE_ADMIN_EMAILS=you@verafo.com

# Local dev ONLY — treat every signed-in user as an admin without an allowlist.
# Never set this in production.
# VITE_DEMO_ADMIN=1
