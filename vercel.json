{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "dest": "/home.html"
    },
    {
      "src": "^/app/?$",
      "status": 307,
      "headers": {
        "Location": "https://gvjbolyoeisyjsphnwze.supabase.co/storage/v1/object/public/downloads/verafo-orders.apk?download=verafo-orders.apk"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
