# Copy to `.env` (never committed). These two values are public — they are
# compiled into the browser bundle — so they are safe to share.
VITE_SUPABASE_URL=https://gvjbolyoeisyjsphnwze.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=the anon / publishable key from Supabase → Settings → API

# Comma-separated emails that get the admin view in this browser.
# The server enforces real admin rights through the `verafo_admins` table; this
# only decides what the UI shows.
VITE_ADMIN_EMAILS=you@verafo.com,cofounder@verafo.com

# DO NOT put the service_role key here. It bypasses every RLS policy and this
# file ends up in a public bundle.
